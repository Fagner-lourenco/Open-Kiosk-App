# ===================================================================
# Open Kiosk App - Variáveis de Ambiente (SANITIZED TEMPLATE)
# ===================================================================
# Este arquivo não deve conter credenciais reais no versionamento.
# Copie e preencha valores reais apenas no ambiente local/seguro.

# ===== Mercado Pago Configuration =====
VITE_MP_MODE=production
VITE_MP_ACCESS_TOKEN_SANDBOX=APP_USR-REPLACE_SANDBOX_TOKEN
VITE_MP_PUBLIC_KEY_SANDBOX=APP_USR-REPLACE_SANDBOX_PUBLIC_KEY
VITE_MP_ACCESS_TOKEN_PRODUCTION=APP_USR-REPLACE_PRODUCTION_TOKEN
VITE_MP_PUBLIC_KEY_PRODUCTION=APP_USR-REPLACE_PRODUCTION_PUBLIC_KEY
VITE_MP_CLIENT_ID=REPLACE_MP_CLIENT_ID
VITE_MP_CLIENT_SECRET=REPLACE_MP_CLIENT_SECRET
VITE_MP_ACCESS_TOKEN=APP_USR-REPLACE_DEFAULT_TOKEN

# ===== Mercado Pago Point (Terminal Físico) =====
VITE_MP_TERMINAL_ID=REPLACE_TERMINAL_ID
VITE_MP_USER_ID=REPLACE_USER_ID
VITE_MP_STORE_ID=REPLACE_STORE_ID
VITE_MP_POS_ID=REPLACE_POS_ID
VITE_MP_EXTERNAL_POS_ID=REPLACE_EXTERNAL_POS_ID
VITE_MP_POINT_EXPIRATION=PT2M

# ===== Firebase Configuration =====
VITE_FIREBASE_API_KEY=REPLACE_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=REPLACE_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=REPLACE_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=REPLACE_FIREBASE_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=REPLACE_FIREBASE_MEASUREMENT_ID

# ===== Modo de Operação =====
VITE_FRANCHISE_MODE=true

# ===== Outras Configurações =====
VITE_DEBUG=false

# ===== Admin PIN Configuration =====
VITE_ROOT_PIN=696365
