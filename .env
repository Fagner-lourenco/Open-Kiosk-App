# Public Key Sandbox (informativo)
VITE_MP_PUBLIC_KEY_SANDBOX=APP_USR-9d7f212d-48ac-4dfb-b6e0-6b0a3fe537a8
# Produção: Para transações reais com cartões reais
VITE_MP_ACCESS_TOKEN_PRODUCTION=APP_USR-4593031529696366-122520-5b54774030cb34e6d131e36338b4351f-1180135961
# Public Key Produção (informativo)
VITE_MP_PUBLIC_KEY_PRODUCTION=APP_USR-a85129a7-9f32-4b5e-94eb-b197e5c525d8
# Client OAuth (informativo; não utilizado neste app)
VITE_MP_CLIENT_ID=4593031529696366
VITE_MP_CLIENT_SECRET=VgeDbM6qJpxDeHhQfmSmKZcwRDWI9JyZ

# Token ativo (será selecionado automaticamente baseado no VITE_MP_MODE)
# Para compatibilidade retroativa, mantemos este campo que será usado se os tokens específicos não existirem
VITE_MP_ACCESS_TOKEN=APP_USR-4593031529696366-122520-5b54774030cb34e6d131e36338b4351f-1180135961

# ===== Mercado Pago Point (Terminal Físico) =====
# Terminal ID: Obtido via API listTerminals ou painel do Mercado Pago
# Formato: TIPO__SERIAL (ex: NEWLAND_N950__N950NCB300544833)
VITE_MP_TERMINAL_ID=NEWLAND_N950__N950NCB300544833

# User ID (necessário para endpoint QR Instore)
VITE_MP_USER_ID=1180135961

# Store e POS IDs: Configurados no painel do Mercado Pago
# IMPORTANTE: Execute os comandos PowerShell para obter estes valores
# Store e POS são necessários para QR/PIX (diferentes do Terminal Point)
VITE_MP_STORE_ID=77497462
VITE_MP_POS_ID=123432995
VITE_MP_EXTERNAL_POS_ID=KIOSKPOS001

# Timeout do terminal em formato ISO 8601 duration (40 segundos para self-service)
VITE_MP_POINT_EXPIRATION=PT40S

# Webhook (não utilizado no momento - reservado para implementação futura)
VITE_MP_WEBHOOK_URL=https://5a3f4574c55f.ngrok-free.app/api/webhooks/mercadopago
VITE_MP_WEBHOOK_SECRET=CHANGE-ME

# Backend (Express) – usa o mesmo token/projeto do frontend
