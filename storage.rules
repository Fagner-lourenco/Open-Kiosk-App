// Firebase Storage Security Rules
// Regras de segurança para arquivos (vídeos de atração, etc.)
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Vídeos de atração das lojas
    // - Leitura: pública (exibido no Kiosk sem auth)
    // - Escrita: apenas usuários autenticados (upload via Admin)
    match /franchises/{franchiseId}/stores/{storeId}/media/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 50 * 1024 * 1024  // max 50MB
                   && request.resource.contentType.matches('video/.*');
    }

    // Bloqueia tudo que não for explicitamente permitido
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
