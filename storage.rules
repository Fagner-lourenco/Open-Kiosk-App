// Firebase Storage Security Rules
// Security rules for store media files
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'superadmin';
    }

    function isFranchiseOwner(franchiseId) {
      return isAuthenticated() &&
             firestore.get(/databases/(default)/documents/franchises/$(franchiseId)).data.ownerId == request.auth.uid;
    }

    function isFranchiseMember(franchiseId) {
      return isAuthenticated() &&
             firestore.exists(/databases/(default)/documents/franchises/$(franchiseId)/members/$(request.auth.uid));
    }

    function getMembership(franchiseId) {
      return firestore.get(/databases/(default)/documents/franchises/$(franchiseId)/members/$(request.auth.uid)).data;
    }

    function hasStoreAccess(franchiseId, storeId) {
      let membership = getMembership(franchiseId);
      return isFranchiseOwner(franchiseId) ||
             (isFranchiseMember(franchiseId) &&
              ('storeAccess' in membership) &&
              ('*' in membership.storeAccess || storeId in membership.storeAccess));
    }

    // Store attract media
    // - Read: public (kiosk display)
    // - Write: only superadmin or tenant user with explicit store access
    match /franchises/{franchiseId}/stores/{storeId}/media/{fileName} {
      allow read: if true;
      allow write: if (isSuperAdmin() || hasStoreAccess(franchiseId, storeId))
                   && request.resource != null
                   && request.resource.size < 50 * 1024 * 1024
                   && (request.resource.contentType.matches('video/.*')
                       || request.resource.contentType.matches('image/.*'));
    }

    // User profile avatar
    // - Read: any authenticated user (avatars appear in team lists)
    // - Write: only the user themselves; images only, max 5MB
    match /users/{userId}/avatar {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && request.auth.uid == userId
                   && request.resource != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}