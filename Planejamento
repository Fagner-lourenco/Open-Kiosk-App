```typescript
async refundSale(saleId: string, adminId: string, reason: string): Promise<void> {
  const db = getFirebaseDb();
  
  return await runTransaction(db, async (transaction) => {
    const saleRef = doc(db, 'sales', saleId);
    const saleSnapshot = await transaction.get(saleRef);
    
    if (!saleSnapshot.exists()) {
      throw new Error('Sale not found');
    }
    
    const sale = saleSnapshot.data() as any;
    
    if (sale.refunded) {
      throw new Error('Sale already refunded');
    }
    
    // Agregar ML/qty a devolver
    const mlReturnedByProductId: Record<string, number> = {};
    const qtyReturnedByProductId: Record<string, number> = {};
    
    sale.items.forEach((item: any) => {
      if (item.mlPerUnit) {
        mlReturnedByProductId[item.productId] = 
          (mlReturnedByProductId[item.productId] || 0) + 
          (item.mlPerUnit * item.quantity);
      } else {
        qtyReturnedByProductId[item.productId] = 
          (qtyReturnedByProductId[item.productId] || 0) + item.quantity;
      }
    });
    
    // Devolver para produtos
    for (const [productId, mlReturned] of Object.entries(mlReturnedByProductId)) {
      const prodRef = doc(db, 'products', productId);
      const prodSnapshot = await transaction.get(prodRef);
      const prod = prodSnapshot.data() as Product;
      
      transaction.update(prodRef, {
        totalMlAvailable: (prod.totalMlAvailable || 0) + mlReturned,
        inStock: true
      });
    }
    
    for (const [productId, qtyReturned] of Object.entries(qtyReturnedByProductId)) {
      const prodRef = doc(db, 'products', productId);
      const prodSnapshot = await transaction.get(prodRef);
      const prod = prodSnapshot.data() as Product;
      
      transaction.update(prodRef, {
        stock: (prod.stock || 0) + qtyReturned,
        inStock: true
      });
    }
    
    // Marcar sale como refunded
    transaction.update(saleRef, {
      refunded: true,
      refundInfo: {
        by: adminId,
        at: new Date(),
        mlReturned: mlReturnedByProductId,
        qtyReturned: qtyReturnedByProductId,
        reason
      }
    });
  });
}
```

