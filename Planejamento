#### **1.5 Handler de Conclusão de Pagamento**
```typescript
const handlePaymentComplete = async () => {
  setIsProcessing(true);
  setPaymentProcessed(true);

  try {
    // 1. Gerar order number
    const newOrderNumber = await salesService.generateOrderNumber();
    setOrderNumber(newOrderNumber);

    // 2. Criar CartItem equivalente
    const size = getSelectedSize();
    if (!size || !product) throw new Error('Size not found');

    const drinkCartItem: CartItem = {
      product,
      quantity,
      unitPrice: size.price,
      sizeKey: selectedSizeKey,
      sizeLabel: size.label,
      mlPerUnit: size.ml,
    };

    // 3. Calcular totais
    const subtotal = size.price * quantity;
    const taxRate = (storeSettings?.taxPercentage || 0) / 100;
    const taxAmount = subtotal * taxRate;
    const totalAmount = subtotal + taxAmount;

    // 4. Registrar venda atomicamente
    await salesService.recordSaleAndUpdateStock(
      [drinkCartItem],
      totalAmount,
      currentCurrency.code,
      newOrderNumber
    );

    console.log('✅ Sale recorded:', newOrderNumber);

    // 5. Liberar bebida no ESP32
    try {
      await esp32Service.releaseDrink({
        orderId: newOrderNumber,
        sizeLabel: size.label,
        mlPerUnit: size.ml,
        quantity,
      });
      console.log('✅ Drink release signal sent to ESP32');
    } catch (esp32Error) {
      console.warn('⚠️ ESP32 release failed (non-blocking):', esp32Error);
      toast({
        title: "Warning",
        description: "Drink dispenser may not be available. Please manually remove your drink.",
        variant: "destructive"
      });
    }

    // 6. Callback com sucesso
    onComplete({
      orderNumber: newOrderNumber,
      drinkData: {
        product,
        sizeKey: selectedSizeKey,
        sizeLabel: size.label,
        mlPerUnit: size.ml,
        price: size.price,
        quantity,
        totalAmount,
      },
    });

  } catch (error) {
    console.error('Payment error:', error);
    toast({
      title: "Error",
      description: (error as Error)?.message || "Payment failed",
      variant: "destructive"
    });
    setPaymentProcessed(false);
    setCurrentStep(3);  // Volta ao passo 3 para retry
  } finally {
    setIsProcessing(false);
  }
};
