      toast({ title: "Error", description: "Select size and quantity", variant: "destructive" });
      return;
    }
    setCurrentStep(2);
  } else if (fromStep === 2) {
    setCurrentStep(3);
  } else if (fromStep === 3) {
    handlePaymentComplete();
  }
};

const handleBack = (fromStep: number) => {
  if (fromStep > 1) {
    setCurrentStep((fromStep - 1) as 1 | 2 | 3 | 4);
  } else {
    onCancel();
  }
};
