<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fitsSystemWindows="true">

    <ImageButton
        android:id="@+id/btn_close"
        android:layout_width="@dimen/commonui_16dp"
        android:layout_height="@dimen/commonui_16dp"
        android:src="@drawable/close"
        android:background="#FFFFFF"
        android:contentDescription="@string/commonui_close"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="@dimen/commonui_8dp"
        android:layout_marginStart="@dimen/commonui_17dp"/>

    <TextView
        android:id="@+id/tv_title_nfc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/commonui_4dp"
        android:text="@string/commonui_pix"
        android:textAlignment="center"
        android:textColor="@color/medium_black"
        android:textSize="@dimen/commonui_18sp"
        app:layout_constraintBottom_toBottomOf="@id/btn_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_subtitle_nfc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/commonui_value"
        android:textColor="@color/plugpag_button_disable_text"
        app:layout_constraintTop_toBottomOf="@id/tv_title_nfc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/commonui_4dp"
        android:textSize="@dimen/commonui_14sp"/>

    <TextView
        android:id="@+id/tv_value_nfc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="R$ 100,00"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle_nfc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/commonui_4dp"
        android:textSize="@dimen/commonui_20sp"
        android:textColor="@color/medium_black" />

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/commonui_1dp"
        android:background="#E2E2E2"
        app:layout_constraintTop_toBottomOf="@id/tv_value_nfc"
        android:layout_margin="@dimen/commonui_4dp"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/nfc_content_gif"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:paddingTop="@dimen/commonui_8dp"
        android:layout_margin="0dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.constraintlayout.widget.Group
            android:id="@+id/nfc_success_content_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible"
            app:constraint_referenced_ids="nfc_description, nfc_gif"/>

        <TextView
            android:id="@+id/nfc_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/commonui_8dp"
            android:text="@string/commonui_bring_your_phone_closer_to_pay"
            android:gravity="center"
            android:textSize="@dimen/commonui_15sp"
            android:textColor="@color/medium_black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <ImageView
            android:id="@+id/nfc_gif"
            android:contentDescription="@string/commonui_nfc_gif"
            android:layout_width="match_parent"
            android:layout_height="@dimen/commonui_149dp"
            android:layout_margin="@dimen/commonui_8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/nfc_description"
            />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/nfc_error_content_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:constraint_referenced_ids="img_nfc_error_icon, txv_nfc_error_title, txv_nfc_error_description, btn_nfc_error_retry"/>

        <ImageView
            android:id="@+id/img_nfc_error_icon"
            android:contentDescription="@string/commonui_nfc_gif"
            android:layout_width="@dimen/commonui_48dp"
            android:layout_height="@dimen/commonui_48dp"
            android:layout_gravity="center"
            android:src="@drawable/close"
            android:background="@drawable/red_hint"
            android:tint="@color/red_error"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="UseAppTint" />

        <TextView
            android:id="@+id/txv_nfc_error_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/commonui_8dp"
            android:text="@string/commonui_nfc_error_title"
            android:gravity="center"
            android:textSize="@dimen/commonui_15sp"
            android:textColor="@color/medium_black"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/img_nfc_error_icon"/>
        <TextView
            android:id="@+id/txv_nfc_error_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/commonui_8dp"
            android:text="@string/commonui_nfc_error_description"
            android:gravity="center"
            android:textSize="@dimen/commonui_15sp"
            android:textColor="@color/neutral_grey"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txv_nfc_error_title"/>
        <Button
            android:id="@+id/btn_nfc_error_retry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/commonui_nfc_error_retry"
            android:textColor="#0078AD"
            android:layout_marginHorizontal="@dimen/commonui_16dp"
            android:layout_marginVertical="@dimen/commonui_24dp"
            android:textSize="@dimen/commonui_15sp"
            style="?android:attr/borderlessButtonStyle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txv_nfc_error_description"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/ll_or_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nfc_content_gif"
        android:gravity="center_vertical">
        <View
            android:layout_width="wrap_content"
            android:layout_height="@dimen/commonui_1dp"
            android:layout_weight="1"
            android:background="#E2E2E2"
            android:layout_marginHorizontal="@dimen/commonui_4dp"/>
        <TextView
            android:id="@+id/tv_or"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/commonui_8dp"
            android:text="@string/commonui_or"
            android:textSize="@dimen/commonui_12sp"
            android:textColor="@color/medium_black"
            android:layout_marginHorizontal="@dimen/commonui_4dp"
            android:textStyle="bold"/>
        <View
            android:layout_width="wrap_content"
            android:layout_height="@dimen/commonui_1dp"
            android:layout_weight="1"
            android:background="#E2E2E2"
            android:layout_marginHorizontal="@dimen/commonui_2dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_qr_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_or_layout"
        android:layout_marginTop="@dimen/commonui_8dp"
        android:text="@string/commonui_scan_code_below_to_pay"
        android:textColor="@color/medium_black"/>

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/commonui_8dp"
        android:layout_marginBottom="@dimen/commonui_8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_qr_code"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btn_cancel_nfc"
        app:cardCornerRadius="@dimen/commonui_10dp"
        app:cardElevation="@dimen/commonui_2dp">
        <br.com.uol.pagseguro.lib.commonui.qrcode.view.qrcode.QRCodeView
            android:id="@+id/qr_code_view_nfc"
            android:layout_width="@dimen/commonui_155dp"
            android:layout_height="@dimen/commonui_155dp"/>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btn_cancel_nfc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="@string/commonui_cancel_sale"
        android:textColor="#0078AD"
        android:layout_marginHorizontal="@dimen/commonui_18dp"
        android:layout_marginVertical="@dimen/commonui_12dp"
        android:textSize="@dimen/commonui_15sp"
        style="?android:attr/borderlessButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>