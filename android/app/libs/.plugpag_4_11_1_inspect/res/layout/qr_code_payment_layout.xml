<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fitsSystemWindows="true"
    android:clipToPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageButton
            android:id="@+id/btn_payment_close"
            android:layout_width="@dimen/commonui_16dp"
            android:layout_height="@dimen/commonui_16dp"
            android:src="@drawable/close"
            android:background="#FFFFFF"
            android:contentDescription="@string/commonui_close"
            android:layout_marginVertical="@dimen/commonui_17dp"
            android:layout_marginStart="@dimen/commonui_17dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tv_payment_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/commonui_17dp"
            android:text="@string/commonui_pix"
            android:textColor="@color/medium_black"
            android:textSize="@dimen/commonui_20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_marginEnd="@dimen/commonui_17dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/ll_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/commonui_32dp">
        <TextView
            android:id="@+id/tv_payment_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/commonui_value"
            android:layout_marginTop="@dimen/commonui_16dp"
            android:textSize="@dimen/commonui_16sp"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:textColor="@color/plugpag_button_disable_text"/>

        <TextView
            android:id="@+id/tv_payment_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="R$ 100,00"
            app:layout_constraintTop_toBottomOf="@id/tv_payment_subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginVertical="@dimen/commonui_16dp"
            android:textSize="@dimen/commonui_24sp"
            android:textStyle="bold"
            android:textColor="@color/medium_black"
            android:layout_gravity="center" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/commonui_1dp"
        android:background="#E2E2E2"
        app:layout_constraintTop_toBottomOf="@id/ll_value"
        android:layout_margin="@dimen/commonui_16dp"/>

    <TextView
        android:id="@+id/tv_qr_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider"
        android:layout_marginTop="@dimen/commonui_16dp"
        android:gravity="center"
        android:text="@string/commonui_scan_code_below_to_pay_with_pix"
        android:textColor="@color/medium_black"/>

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/commonui_16dp"
        android:layout_marginBottom="@dimen/commonui_8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_qr_code"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btn_payment_cancel"
        app:cardCornerRadius="@dimen/commonui_10dp"
        app:cardElevation="@dimen/commonui_2dp">
        <br.com.uol.pagseguro.lib.commonui.qrcode.view.qrcode.QRCodeView
            android:id="@+id/payment_qr_code_view"
            android:layout_width="@dimen/commonui_230dp"
            android:layout_height="@dimen/commonui_230dp"/>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btn_payment_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="@string/commonui_cancel_sale"
        android:textColor="#0078AD"
        android:layout_marginHorizontal="@dimen/commonui_16dp"
        android:layout_marginVertical="@dimen/commonui_24dp"
        android:textSize="@dimen/commonui_15sp"
        style="?android:attr/borderlessButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>