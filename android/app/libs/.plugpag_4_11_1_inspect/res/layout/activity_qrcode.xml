<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:fitsSystemWindows="true"
    android:background="@color/plugpag_white">

    <TextView
        android:id="@+id/textview_info"
        style="@style/qr_code_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/payment_qrcode_title"
        android:textAlignment="center"
        android:layout_marginTop="@dimen/size_all_xmedium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textview_subtitle"
        style="@style/qr_code_subtitle_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size_all_ylarge"
        android:layout_marginVertical="@dimen/size_all_ymedium"
        android:layout_marginTop="@dimen/size_all_medium"
        android:layout_marginBottom="@dimen/size_minus_xsmall"
        android:gravity="center"
        android:text="@string/subtitle_qrCodeActivation"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textview_info" />

    <br.com.uol.pagseguro.plugpag.qrcode.utils.QRCodeView
        android:id="@+id/qrCodeView"
        android:layout_width="@dimen/size_all_qrcode"
        android:layout_height="@dimen/size_all_qrcode"
        android:layout_marginTop="@dimen/size_all_medium"
        app:layout_constraintTop_toBottomOf="@id/textview_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textview_value"
        style="@style/titleBlack"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/qrCodeView" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:padding="@dimen/size_all_medium"
        app:layout_goneMarginTop="@dimen/size_minus_xmedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/payment_qrcode_wait_until_it_is_payed"
        android:textAlignment="center"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/button_pagbank_manual"
        android:layout_marginBottom="@dimen/size_all_xmedium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textview_value">

        <TextView
            android:id="@+id/textview_wait_until_it_is_payed"
            style="@style/qr_code_bold_text"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_all_medium"
            app:layout_goneMarginStart="0dp"
            android:text="@string/payment_qrcode_wait_until_it_is_payed"
            android:textAlignment="center"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/progress_qr_code"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress_qr_code"
            android:layout_width="@dimen/size_all_large"
            android:layout_height="@dimen/size_all_large"
            android:indeterminate="true"
            app:indicatorColor="@color/blue"
            app:indicatorSize="@dimen/size_all_xxmedium"
            app:layout_constraintBottom_toBottomOf="@id/textview_wait_until_it_is_payed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/textview_wait_until_it_is_payed" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <Button
        android:id="@+id/button_pagbank_manual"
        style="@style/PlugPagButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_all_xmedium"
        android:layout_marginEnd="@dimen/size_all_xmedium"
        android:layout_marginBottom="@dimen/size_all_small"
        android:text="@string/button_manual_activation_qrCodeActivation"
        android:textAllCaps="false"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/button_cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/button_cancel"
        style="@style/PlugPagBorderlessButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_all_xmedium"
        android:layout_marginEnd="@dimen/size_all_xmedium"
        android:layout_marginBottom="@dimen/size_all_medium"
        android:text="@string/payment_qrcode_cancel"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>