<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="br.com.uol.pagseguro.plugpag" >

    <uses-sdk
        android:minSdkVersion="19"
        android:targetSdkVersion="29"
        tools:overrideLibrary="br.com.setis.sunmi.ppcomp.ppcomp_p2" />

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission
        android:name="android.permission.READ_PRIVILEGED_PHONE_STATE"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="br.com.uol.pagseguro.permission.READ_TERMINAL_PROVIDER" />
    <uses-permission android:name="br.com.uol.pagseguro.permission.WRITE_TERMINAL_PROVIDER" />
    <uses-permission android:name="android.permission.NFC" />

    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="@string/app_name"
        android:supportsRtl="true"
        tools:node="merge" >
        <activity
            android:name="br.com.uol.pagseguro.plugpag.PlugPagActivity"
            android:allowTaskReparenting="false"
            android:alwaysRetainTaskState="false"
            android:autoRemoveFromRecents="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:resizeableActivity="false"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar.Fullscreen"
            android:windowSoftInputMode="adjustResize"
            tools:node="strict" />
        <activity
            android:name="br.com.uol.pagseguro.plugpag.TransparentActivity"
            android:allowTaskReparenting="false"
            android:alwaysRetainTaskState="false"
            android:autoRemoveFromRecents="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:resizeableActivity="false"
            android:stateNotNeeded="true"
            android:theme="@style/TransparentActivity"
            android:windowSoftInputMode="adjustResize"
            tools:node="strict" />
        <activity
            android:name="br.com.uol.pagseguro.plugpag.qrcode.view.QrCodeActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:theme="@style/TransparentActivity"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />
        <activity
            android:name="br.com.uol.pagseguro.plugpag.listener.view.PartialPayConfirmationActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:theme="@style/TransparentActivity"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />
        <activity
            android:name="br.com.uol.pagseguro.lib.commonui.qrcode.view.qrcode.QrCodeActivity"
            android:exported="true"
            android:launchMode="singleInstance"
            android:theme="@style/TransparentActivity"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />
        <activity
            android:name="br.com.uol.pagseguro.feature.taponpix.view.TapOnPixBaseActivity"
            android:exported="true" >
        </activity>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge" >
            <meta-data
                android:name="br.com.uol.pagseguro.lib.metrics.inject.MetricsInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="br.com.uol.pagseguro.lib.metrics.v2.inject.MetricsInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="br.com.uol.pagseguro.lib.inject.initializer.InternalInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>

</manifest>