# ===== Mercado Pago Configuration =====
# Access Token (obtido em: https://www.mercadopago.com.br/developers/panel/app)
# SANDBOX: TEST-*****************************
# PRODUCTION: APP_USR-*****************************
VITE_MP_ACCESS_TOKEN=TEST-1234567890abcdefghijklmnopqrstuvwxyz

# Modo de operação: 'sandbox' ou 'production'
VITE_MP_MODE=sandbox

# URL do webhook para notificações de pagamento
# Desenvolvimento: usar ngrok ou cloudflare tunnel
# Exemplo: https://abc123.ngrok-free.app/api/webhooks/mercadopago
VITE_MP_WEBHOOK_URL=https://localhost:3000/api/webhooks/mercadopago

# Secret para validação de assinatura de webhooks (HMAC-SHA256)
# Obtido no painel do Mercado Pago em configurações de webhook
VITE_MP_WEBHOOK_SECRET=your_webhook_secret_here

# User ID da conta Mercado Pago (encontrado em Suas Integrações)
VITE_MP_USER_ID=123456789

# ID do Terminal Point (no formato TIPO__SERIAL, ex: NEWLAND_N950__N950NCB801293324)
# Se deixar em branco, será buscado automaticamente via API
VITE_MP_TERMINAL_ID=

# External POS ID (ID customizado do caixa)
VITE_MP_EXTERNAL_POS_ID=LOJ001POS001

# ===== Firebase Configuration =====
# (mantido da configuração existente)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ===== Outras Configurações =====
# Porta do servidor backend (se houver)
PORT=3000

# Modo de debug
VITE_DEBUG=false
