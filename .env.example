# ===================================================================
# Open Kiosk App - Variáveis de Ambiente
# ===================================================================
# Copie este arquivo para .env e preencha os valores reais
# cp .env.example .env
# ===================================================================

# ===== Mercado Pago Configuration =====
# Modo: 'sandbox' para testes, 'production' para produção
VITE_MP_MODE=sandbox

# Tokens de acesso (obtidos no painel do Mercado Pago > Credenciais)
# https://www.mercadopago.com.br/developers/panel/app
#
# Sandbox: Para testes com cartões fictícios (use credenciais de teste)
VITE_MP_ACCESS_TOKEN_SANDBOX=APP_USR-xxxxxxxxx-xxxxxx-xxxxxxxxxxxxx-xxxxxxxxxx
#
# Produção: Para transações reais com cartões reais (use credenciais de produção)
VITE_MP_ACCESS_TOKEN_PRODUCTION=APP_USR-xxxxxxxxx-xxxxxx-xxxxxxxxxxxxx-xxxxxxxxxx
#
# Token legado (para compatibilidade - será usado se os tokens específicos não existirem)
VITE_MP_ACCESS_TOKEN=APP_USR-xxxxxxxxx-xxxxxx-xxxxxxxxxxxxx-xxxxxxxxxx

# ===== Mercado Pago Point (Terminal Físico) =====
# Terminal ID: Obtido via API listTerminals ou painel do Mercado Pago
# Formato: TIPO__SERIAL (ex: NEWLAND_N950__N950NCB300544833)
# Se não configurado, o sistema buscará automaticamente um terminal em modo PDV
VITE_MP_TERMINAL_ID=

# Store e POS IDs: Configurados no painel do Mercado Pago
# Crie em: https://www.mercadopago.com.br/developers/panel/point/stores
VITE_MP_STORE_ID=
VITE_MP_POS_ID=
VITE_MP_EXTERNAL_POS_ID=LOJ001POS001

# Timeout do terminal em formato ISO 8601 duration
# PT3M = 3 minutos (recomendado para self-service)
# PT5M = 5 minutos
# PT10M = 10 minutos
VITE_MP_POINT_EXPIRATION=PT3M

# Webhook (reservado para implementação futura)
# Configure um servidor para receber notificações de pagamento
VITE_MP_WEBHOOK_URL=https://seu-dominio.com/api/webhooks/mercadopago
VITE_MP_WEBHOOK_SECRET=gere-um-segredo-aleatorio

# ===== Backend (Express) =====
# Usa o mesmo token/projeto do frontend
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxx-xxxxxx-xxxxxxxxxxxxx-xxxxxxxxxx
MP_WEBHOOK_SECRET=gere-um-segredo-aleatorio
MP_WEBHOOK_VALIDATE=false

# ===== Firebase Configuration =====
# Obtido no Console do Firebase > Configurações do Projeto > Apps da Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Backend Firestore REST (mesmo projeto)
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# ===== Outras Configurações =====
# Porta do servidor backend (se houver)
PORT=3000

# Modo de debug
VITE_DEBUG=false
