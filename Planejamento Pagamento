}

export function useCheckoutFlow(options: UseCheckoutFlowOptions) {
  const [state, setState] = useState<CheckoutFlowState>(/* ... */);

  // NEW: Setup webhook listener
  useEffect(() => {
    if (!state.orderId || !state.isWebhookListening) return;

    const socket = new WebSocket(process.env.VITE_WS_URL!);

    socket.onmessage = (event) => {
      const message = JSON.parse(event.data);

      if (message.type === 'order:completed' && message.orderId === state.orderId) {
        console.log('[CHECKOUT] Webhook recebido:', message);
        actions.complete();
        actions.updateProcessingStage('complete');
      }
    };

    return () => socket.close();
  }, [state.orderId, state.isWebhookListening]);

  // NEW: Polling fallback (se webhook falhar)
  useEffect(() => {
    if (!state.isWebhookListening || !state.orderId) return;

    const pollInterval = setInterval(async () => {
      try {
        const status = await paymentService.getPaymentStatus(state.orderId!);

        if (status.status === 'closed' || status.status === 'processed') {
          actions.complete();
          actions.updateProcessingStage('complete');
          clearInterval(pollInterval);
        }

        setState(prev => ({
          ...prev,
          lastWebhookAt: new Date(),
          reconciliationRetries: 0
        }));
      } catch (error) {
        setState(prev => ({
          ...prev,
          reconciliationRetries: prev.reconciliationRetries + 1
        }));
      }
    }, 5000); // Poll a cada 5s

    return () => clearInterval(pollInterval);
  }, [state.isWebhookListening, state.orderId]);

  // NEW: Action para iniciar QR
  const initiateQRCheckout = useCallback(async (amount: number) => {
    actions.updateProcessingStage('awaiting_payment');
    actions.setIsProcessing(true);

    try {
      const result = await paymentService.initiateQRPayment(
        amount,
        `KIOSK_${Date.now()}`
      );

      setState(prev => ({
        ...prev,
        orderId: result.orderId,
        qrData: result.qrData,
        paymentType: 'qr',
        isWebhookListening: true,
        reconciliationRetries: 0
      }));

      return result;
    } catch (error) {
      actions.setError(String(error));
      throw error;
    }
  }, []);

  // NEW: Action para iniciar Point
  const initiatePointCheckout = useCallback(async (amount: number) => {
    actions.updateProcessingStage('awaiting_payment');
    actions.setIsProcessing(true);

    try {
      const result = await paymentService.initiatePointPayment(amount, `KIOSK_${Date.now()}`);

      setState(prev => ({
        ...prev,
        orderId: result.orderId,
        paymentType: 'point',
        isWebhookListening: true,
        reconciliationRetries: 0
      }));

      return result;
    } catch (error) {
      actions.setError(String(error));
      throw error;
    }
  }, []);

  return {
    state,
    actions: { ...actions, initiateQRCheckout, initiatePointCheckout }
  };
}
