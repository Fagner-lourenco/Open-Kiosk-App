## 6. WEBHOOKS E RECONCILIAÇÃO {#webhooks}

### 6.1 Arquitetura Webhook

```
┌─────────────────────────────────────┐
│  Cliente Scanneia QR / Usa Terminal  │
│  Transação processada no MP         │
└─────────────────────────┬───────────┘
                          │
                 (2-5s latência)
                          ▼
            ┌──────────────────────────┐
            │ Mercado Pago             │
            │ Detecta status="closed"  │
            └──────────────┬───────────┘
                           │
                    Envia webhook
                    (retry automático)
                           ▼
        ┌──────────────────────────────────────┐
        │ Backend Webhook Receiver             │
        │ POST /api/webhooks/mercadopago       │
        │                                      │
        │ 1. Valida X-Signature                │
        │ 2. Deduplicação (X-Request-Id)       │
        │ 3. GET /v1/orders/{id} reconciliation│
        │ 4. Atualiza BD                       │
        │ 5. Emite WebSocket ao frontend       │
        │                                      │
        │ Response: 200 OK                     │
        └──────────────────────────────────────┘
                           │
                    ┌──────┴──────┐
                    ▼             ▼
        ┌──────────────────┐  ┌─────────────┐
        │ Update Storage   │  │ WebSocket   │
        │ Sales record     │  │ to Frontend │
        │ Inventory adj    │  │ Real-time   │
        │ Audit log        │  │ notification│
        └──────────────────┘  └─────────────┘
                    │
                    ▼
        ┌──────────────────────────────────────┐
        │ Frontend                             │
        │ Exibe confirmação                    │
        │ Toca som de sucesso                  │
        │ Oferece opções: nova compra, sair    │
        └──────────────────────────────────────┘
```

### 6.2 Endpoint Backend: POST /api/webhooks/mercadopago

**Configuração no Dashboard MP:**

1. Suas Integrações → App
2. Notificações → Webhooks
3. Adicionar URL:
   - Sandbox: `https://seu-backend.test/api/webhooks/mercadopago`
   - Prod: `https://seu-backend.com/api/webhooks/mercadopago` (SSL obrigatório)
4. Inscrever em eventos: `order.notification`

**Webhook Request Recebido:**

```
POST /api/webhooks/mercadopago HTTP/1.1
Host: seu-backend.com
Content-Type: application/json
X-Signature: sha256=xxxx
X-Request-Id: 12345-abcde-67890

{
  "id": "ORDER_WEBHOOK_1234567890",
  "type": "order",
  "data": {
    "id": "ORD00001111222233334444555566"
  },
  "timestamp": "2025-12-25T14:35:42Z"
}
```

### 6.3 Validação de Assinatura (X-Signature)

**Algoritmo (conforme Mercado Pago):**

```
signature = HMAC-SHA256(
  secret = MERCADOPAGO_WEBHOOK_SECRET,
  message = {id}.{timestamp}.{request_body_raw}
)
```

**Implementação TypeScript (Backend):**

```typescript
import crypto from 'crypto';

function validateMercadopagoSignature(
  requestBody: string,
  webhookSecret: string,
  signature: string,
  timestamp: string,
  id: string
): boolean {
  // 1. Compor mensagem: id.timestamp.body
  const message = `${id}.${timestamp}.${requestBody}`;
  
  // 2. Computar HMAC-SHA256
  const computed = crypto
    .createHmac('sha256', webhookSecret)
    .update(message)
    .digest('hex');
  
  // 3. Comparação timing-safe (evita timing attacks)
  try {
    return crypto.timingSafeEqual(
      Buffer.from(signature),
      Buffer.from(computed)
    );
  } catch {
    return false;
  }
}

// Uso em Express middleware
app.post('/api/webhooks/mercadopago', (req, res) => {
  const rawBody = req.rawBody; // Salvar body bruto ANTES de parse
  const { 'x-signature': signature, 'x-timestamp': timestamp } = req.headers;
  const { id } = req.body;

  if (!validateMercadopagoSignature(rawBody, process.env.WEBHOOK_SECRET!, signature as string, timestamp as string, id)) {
    console.error('❌ Webhook falhou validação de assinatura');
    return res.status(401).json({ error: 'Invalid signature' });
  }

  console.log('✅ Webhook assinatura válida');
  res.status(200).json({ status: 'received' });
  
  // Processar em background (não bloquear resposta)
  handleWebhook(req.body).catch(e => console.error('Erro webhook:', e));
});
```

**⚠️ Importância:**
- Previne **replay attacks** (mesmo webhook N vezes)
- Valida que veio de Mercado Pago (não cliente malicioso)
- **OBRIGATÓRIO antes de processar**

### 6.4 Processamento Webhook – GET Order Reconciliation

```typescript
async function handleWebhook(webhook: any) {
  const { data: { id: orderId }, id: webhookId, timestamp } = webhook;

  console.log(`[WEBHOOK] Processando: ${orderId}`);

  try {
    // 1. Deduplicação (X-Request-Id)
    const existing = await db
      .collection('webhook_log')
      .doc(webhookId)
      .get();

    if (existing.exists) {
      console.log(`[WEBHOOK] Já processado: ${webhookId}. Ignorando.`);
      return;
    }

    // 2. GET /v1/orders/{order_id} – RECONCILIAÇÃO IMEDIATA
    const mpOrder = await mercadopagoAPI.getOrder(orderId);

    // 3. Atualizar BD
    await db.collection('orders').doc(orderId).update({
      status: mpOrder.status,
      statusDetail: mpOrder.status_detail,
      syncedAt: new Date(),
      webhookReceivedAt: new Date(timestamp),
      lastPaymentId: mpOrder.transactions?.payments?.[0]?.id,
      lastRefundId: mpOrder.transactions?.refunds?.[0]?.id
    });

    // 4. Log webhook recebido
    await db.collection('webhook_log').doc(webhookId).set({
      orderId,
      status: mpOrder.status,
      receivedAt: new Date(timestamp),
      processedAt: new Date()
    });

    // 5. Se pagamento confirmado → Finalizar venda
    if (mpOrder.status === 'closed') {
      console.log(`[WEBHOOK] Ordem ${orderId} fechada. Finalizando...`);
      await finalizeOrder(orderId);
    }
  } catch (error) {
    console.error(`[WEBHOOK ERROR] ${orderId}:`, error);
    
    // Logar para investigação
    await db.collection('webhook_errors').add({
      orderId,
      error: error.message,
      timestamp: new Date()
    });
  }
}

async function finalizeOrder(orderId: string) {
  const order = await db.collection('orders').doc(orderId).get();
  const orderData = order.data();

  // 1. Update estoque
  for (const item of orderData.items) {
    await db
      .collection('products')
      .doc(item.productId)
      .update({
        stock: admin.firestore.FieldValue.increment(-item.quantity)
      });
  }

  // 2. Gerar recibo
  const receipt = await generateReceipt(orderData);

  // 3. Imprimir (se configurado)
  if (process.env.PRINTER_ENABLED === 'true') {
    await printReceipt(receipt);
  }

  // 4. Marcar como finalizada
  await db.collection('orders').doc(orderId).update({
    finalizedAt: new Date(),
    receiptId: receipt.id
  });

  console.log(`✅ Ordem ${orderId} finalizada`);
}
```

### 6.5 Fallback: Polling (Se Webhook Falhar)

**Problema:** Webhook pode não chegar (network, timeout, MP retry limit).

**Solução:** Background job polling periodicamente.

```typescript
async function reconcilePendingOrders() {
  console.log('[RECONCILIATION] Iniciando...');

  // 1. Buscar orders "não confirmadas" nos últimos 20min
  const pending = await db
    .collection('orders')
    .where('status', 'in', ['created', 'opened'])
    .where('createdAt', '>', new Date(Date.now() - 20 * 60000))
    .get();

  console.log(`[RECONCILIATION] ${pending.size} ordens pendentes`);

  for (const doc of pending.docs) {
    const order = doc.data();

    try {
      // 2. GET do Mercado Pago (REQUERIDO)
      const mpOrder = await mercadopagoAPI.getOrder(order.mpOrderId);

      // 3. Comparar status
      if (mpOrder.status !== order.status) {
        console.log(
          `[RECONCILIATION] Divergência detectada: ${order.mpOrderId}`
        );
        console.log(`  BD:        ${order.status}`);
        console.log(`  Mercado:   ${mpOrder.status}`);

        // 4. Atualizar BD com status real
        await db.collection('orders').doc(doc.id).update({
          status: mpOrder.status,
          statusDetail: mpOrder.status_detail,
          syncedAt: new Date(),
          reconciliationFlag: true, // Auditoria
          paymentId: mpOrder.transactions?.payments?.[0]?.id,
          refundId: mpOrder.transactions?.refunds?.[0]?.id
        });

        // 5. Se foi pago mas não finalizado → Finalizar
        if (mpOrder.status === 'closed' && order.status !== 'closed') {
          console.log(`[RECONCILIATION] Finalizando venda ${order.mpOrderId}`);
          await finalizeOrder(order.mpOrderId);
        }
      }
    } catch (error) {
      console.error(`[RECONCILIATION ERROR] ${order.mpOrderId}:`, error);
    }
  }
}

